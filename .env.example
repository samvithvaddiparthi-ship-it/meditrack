# Copy to .env and replace every <placeholder>. Never commit .env.

# --- Docker Compose (only if you use `npm run db:up`) ---
MYSQL_ROOT_PASSWORD=<strong-random-root-password>
MYSQL_USER=meditrack
MYSQL_PASSWORD=<strong-random-app-password>
MYSQL_HOST_PORT=3307
MONGO_ROOT_USER=meditrack
MONGO_ROOT_PASSWORD=<strong-random-mongo-password>
MONGO_HOST_PORT=27017

# --- Application ---
# MySQL 8 (InnoDB). The user needs ALL on meditrack, meditrack_test and meditrack_shadow.
DATABASE_URL="mysql://meditrack:<app-password>@127.0.0.1:3307/meditrack"
# Used only by `prisma migrate dev` when creating new migrations.
SHADOW_DATABASE_URL="mysql://meditrack:<app-password>@127.0.0.1:3307/meditrack_shadow"
# Integration tests refuse to run unless the database name ends with _test.
TEST_DATABASE_URL="mysql://meditrack:<app-password>@127.0.0.1:3307/meditrack_test"

# Local MongoDB or MongoDB Atlas (mongodb+srv://...).
MONGODB_URI="mongodb://meditrack:<mongo-password>@127.0.0.1:27017/?authSource=admin"
MONGODB_DB=meditrack
TEST_MONGODB_DB=meditrack_test

# Default expiry-alert window in days (1-365).
EXPIRY_ALERT_DAYS=30

# Optional: passwords given to the demo accounts by `npm run db:seed`
# (min 10 chars, letters + digits). If omitted, random ones are printed once.
DEMO_ADMIN_PASSWORD=<choose-a-demo-admin-password>
DEMO_STAFF_PASSWORD=<choose-a-demo-staff-password>
